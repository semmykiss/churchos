# Copy this file to .env and adjust if needed.

# ── Database ────────────────────────────────────────────────────────────────
# Local dev (SQLite, file relative to the prisma folder):
DATABASE_URL="file:../db/custom.db"
# Hosted production (Vercel + Neon/Vercel Postgres) — use the pooled connection
# string from your provider. The build uses prisma/schema.postgres.prisma:
# DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/churchos?sslmode=require"
# Optional: direct chat websocket URL for deployments WITHOUT the built-in
# gateway (e.g. plain Windows installs). Leave empty to use the gateway.
# NEXT_PUBLIC_CHAT_WS_URL="http://localhost:3003"

# ── Stripe (online giving) ──────────────────────────────────────────────
# When STRIPE_SECRET_KEY is set the give flow runs REAL Stripe PaymentIntents
# (saved cards confirm off-session; SCA/ACH return a clientSecret the browser
# confirms with Stripe.js, and the signed webhook settles the ledger).
# Leave empty to use the built-in demo processor (synchronous settlement).
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."           # required for /api/webhooks/stripe
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."  # required for Stripe.js/Elements

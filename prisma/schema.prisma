// ChurchOS — Prisma schema (SQLite adapter)
// NOTE: The original spec requested Supabase/PostgreSQL. This sandbox environment
// is restricted to SQLite via Prisma, so we adapt: enums become String with app-level
// validation, arrays become Json, and RLS is enforced in the application permission layer
// (lib/permissions.ts) instead of database RLS policies. See README "Assumptions".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization & access control
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  timezone  String   @default("Africa/Lagos")
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches     Branch[]
  users        User[]
  members      Member[]
  settings     Setting[]
  departments  Department[]
  services     Service[]
  visitors     Visitor[]
  followUps    FollowUpTask[]
  events       Event[]
  funds        Fund[]
  donations    Donation[]
  expenses     Expense[]
  budgets      Budget[]
  announcements Announcement[]
  pastoralCases PastoralCase[]
  prayerRequests PrayerRequest[]
  tasks        Task[]
  meetings     Meeting[]
  approvals    Approval[]
  assets       Asset[]
  bookings     Booking[]
  documents    Document[]
  importJobs   ImportJob[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  location       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        Member[]
  services       Service[]
  attendance     AttendanceSession[]
  events         Event[]
  @@index([organizationId])
}

model User {
  id            String   @id @default(cuid())
  organizationId String
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("member") // super_admin, church_admin, pastor, finance_officer, department_head, department_assistant, unit_leader, member, guest
  phone         String?
  avatarUrl     String?
  active        Boolean  @default(true)
  departmentId  String?  // scope for department_head / assistant
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department    Department? @relation("UserDepartment", fields: [departmentId], references: [id])
  auditLogs     AuditLog[]
  followUpsOwned Member[] @relation("FollowUpOwner")
  headedDepartment Department? @relation("DepartmentHead")
  @@index([organizationId])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Membership CRM
// ---------------------------------------------------------------------------

model Member {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  memberId       String?  // human-friendly membership number
  firstName      String
  lastName       String
  middleName     String?
  preferredName  String?
  gender         String?  // male | female | other
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  address        String?
  emergencyName  String?
  emergencyPhone String?
  status         String   @default("visitor") // visitor, new_convert, follow_up, active, inactive, transferred, deceased
  isMinor        Boolean  @default(false)
  guardianName   String?
  dateJoined     DateTime @default(now())
  baptized       Boolean  @default(false)
  baptizedDate   DateTime?
  notes          String?
  privateNotes   String?  // restricted
  photoUrl       String?
  followUpOwnerId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?   @relation(fields: [branchId], references: [id])
  followUpOwner   User?     @relation("FollowUpOwner", fields: [followUpOwnerId], references: [id])
  departmentMemberships DepartmentMembership[]
  attendance     AttendanceRecord[]
  donations      Donation[]
  pastoralCases  PastoralCase[]
  prayers        PrayerRequest[]
  statusHistory  MemberStatusHistory[]
  @@index([organizationId])
  @@index([status])
  @@index([branchId])
}

model MemberStatusHistory {
  id          String   @id @default(cuid())
  memberId    String
  status      String
  reason      String?
  changedAt    DateTime @default(now())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@index([memberId])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  headUserId     String?  @unique
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  head           User?   @relation("DepartmentHead", fields: [headUserId], references: [id])
  members        User[]  @relation("UserDepartment")
  memberships    DepartmentMembership[]
  events         Event[]
  tasks          Task[]
  units          Unit[]
  @@index([organizationId])
}

model DepartmentMembership {
  id           String   @id @default(cuid())
  memberId     String
  departmentId String
  role         String   @default("member") // leader, assistant, secretary, member
  joinedAt     DateTime @default(now())
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  @@unique([memberId, departmentId])
  @@index([departmentId])
}

model Unit {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  leaderUserId String?
  createdAt    DateTime @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Attendance & services
// ---------------------------------------------------------------------------

model Service {
  id          String   @id @default(cuid())
  organizationId String
  branchId    String?
  name        String
  serviceType String   @default("sunday_worship")
  dayOfWeek   Int?     // 0-6
  startTime   String?
  endTime     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?  @relation(fields: [branchId], references: [id])
  sessions    AttendanceSession[]
  @@index([organizationId])
}

model AttendanceSession {
  id          String   @id @default(cuid())
  serviceId   String
  branchId    String?
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch      Branch?  @relation(fields: [branchId], references: [id])
  records     AttendanceRecord[]
  @@index([serviceId])
  @@index([date])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  sessionId   String
  memberId    String?
  visitorName String?
  checkInMethod String @default("manual") // manual | qr
  checkInTime DateTime @default(now())
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, memberId])
  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Visitors & follow-up
// ---------------------------------------------------------------------------

model Visitor {
  id            String   @id @default(cuid())
  organizationId String
  firstName     String
  lastName      String
  phone         String?
  email         String?
  address       String?
  referralSource String?
  firstVisitDate DateTime @default(now())
  convertedMemberId String?
  consent       Boolean  @default(true)
  createdAt     DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  followUps     FollowUpTask[]
  @@index([organizationId])
}

model FollowUpTask {
  id           String   @id @default(cuid())
  visitorId    String?
  memberId     String?
  organizationId String
  ownerId      String?
  status       String   @default("pending") // pending, in_progress, done, lost
  dueDate      DateTime?
  notes        String?
  outcome      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor      Visitor? @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  interactions FollowUpInteraction[]
  @@index([organizationId])
  @@index([status])
}

model FollowUpInteraction {
  id        String   @id @default(cuid())
  taskId    String
  method    String   @default("call") // call, sms, email, visit
  notes     String?
  createdAt DateTime @default(now())
  task      FollowUpTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Events & calendar
// ---------------------------------------------------------------------------

model Event {
  id            String   @id @default(cuid())
  organizationId String
  branchId      String?
  departmentId  String?
  title         String
  description   String?
  eventType     String   @default("service") // service, conference, meeting, retreat, outreach, training, special
  venue         String?
  capacity      Int?
  startDate     DateTime
  endDate       DateTime?
  status        String   @default("scheduled") // scheduled, approved, cancelled, completed
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?  @relation(fields: [branchId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])
  registrations Registration[]
  @@index([organizationId])
  @@index([startDate])
}

model Registration {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@unique([eventId, email])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Finance & giving
// ---------------------------------------------------------------------------

model Fund {
  id            String   @id @default(cuid())
  organizationId String
  name          String
  code          String?
  description   String?
  balance       Float    @default(0)
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  donations     Donation[]
  expenses      Expense[]
  budgets       Budget[]
  @@index([organizationId])
}

model Donation {
  id            String   @id @default(cuid())
  organizationId String
  fundId        String?
  memberId      String?
  donorName     String?
  amount        Float
  currency      String   @default("NGN")
  method        String   @default("cash") // cash, transfer, card, online
  reference     String?
  status        String   @default("confirmed") // pending, confirmed, failed, refunded
  donatedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  fund          Fund?    @relation(fields: [fundId], references: [id])
  member        Member?  @relation(fields: [memberId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([donatedAt])
}

model Expense {
  id            String   @id @default(cuid())
  organizationId String
  fundId        String?
  category      String
  description   String
  amount        Float
  payee         String?
  method        String   @default("cash")
  reference     String?
  status        String   @default("pending") // pending, approved, paid, rejected
  approvedBy    String?
  incurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  fund          Fund?    @relation(fields: [fundId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([status])
}

model Budget {
  id            String   @id @default(cuid())
  organizationId String
  fundId        String?
  fiscalYear    Int
  period        String   @default("annual")
  amount        Float
  createdAt     DateTime @default(now())
  fund          Fund?    @relation(fields: [fundId], references: [id])
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Communications
// ---------------------------------------------------------------------------

model Announcement {
  id            String   @id @default(cuid())
  organizationId String
  title         String
  body          String
  audience      String   @default("all") // all, members, department, leaders
  departmentId  String?
  published     Boolean  @default(true)
  pinned        Boolean  @default(false)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Pastoral care & welfare
// ---------------------------------------------------------------------------

model PastoralCase {
  id            String   @id @default(cuid())
  organizationId String
  memberId      String?
  type          String   @default("prayer") // prayer, counselling, visitation, bereavement, hospital, welfare
  status        String   @default("open") // open, in_progress, resolved, closed
  priority      String   @default("normal") // low, normal, high, urgent
  assignedToId  String?
  description   String?
  privateNotes  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  member        Member?  @relation(fields: [memberId], references: [id])
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([status])
}

model PrayerRequest {
  id           String   @id @default(cuid())
  organizationId String
  memberId     String?
  name         String?
  request      String
  private      Boolean  @default(false)
  status       String   @default("open")
  createdAt    DateTime @default(now())
  member       Member?  @relation(fields: [memberId], references: [id])
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Tasks, meetings, approvals
// ---------------------------------------------------------------------------

model Task {
  id           String   @id @default(cuid())
  organizationId String
  departmentId String?
  title        String
  description  String?
  assigneeId   String?
  status       String   @default("todo") // todo, in_progress, done, blocked
  priority     String   @default("normal")
  dueDate      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([status])
}

model Meeting {
  id            String   @id @default(cuid())
  organizationId String
  title         String
  agenda        String?
  minutes       String?
  location      String?
  attendees     String?
  scheduledAt   DateTime
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

model Approval {
  id            String   @id @default(cuid())
  organizationId String
  type          String   // expense, event, member_status, document
  refId         String
  requesterId   String?
  approverId    String?
  status        String   @default("pending") // pending, approved, rejected
  comment       String?
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Assets & facilities
// ---------------------------------------------------------------------------

model Asset {
  id            String   @id @default(cuid())
  organizationId String
  tag           String?
  name          String
  category      String   // equipment, instrument, furniture, vehicle, building, it
  location      String?
  custodian     String?
  condition     String   @default("good") // good, fair, damaged, retired
  acquiredAt    DateTime?
  value         Float?
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([category])
}

model Booking {
  id            String   @id @default(cuid())
  organizationId String
  resource      String
  title         String
  bookedBy      String?
  startAt       DateTime
  endAt         DateTime
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Document {
  id            String   @id @default(cuid())
  organizationId String
  title         String
  category      String   @default("policy") // policy, template, minutes, form, report, resource
  description   String?
  fileUrl       String?
  fileName      String?
  accessLevel   String   @default("staff") // public, members, staff, leaders, finance, pastoral
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([accessLevel])
}

// ---------------------------------------------------------------------------
// Audit log & settings
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(cuid())
  organizationId String?
  actorId       String?
  action        String
  targetType    String?
  targetId      String?
  metadata      String?
  ip            String?
  createdAt     DateTime @default(now())
  actor         User?    @relation(fields: [actorId], references: [id])
  @@index([organizationId])
  @@index([actorId])
  @@index([action])
}

model Setting {
  id            String   @id @default(cuid())
  organizationId String
  key           String
  value         String
  updatedAt     DateTime @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, key])
}

model ImportJob {
  id            String   @id @default(cuid())
  organizationId String
  kind          String
  fileName      String
  totalRows     Int      @default(0)
  successRows   Int      @default(0)
  errorRows     Int      @default(0)
  status        String   @default("pending")
  errors        String?
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

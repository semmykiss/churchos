// ChurchOS — Prisma schema (SQLite adapter)
// NOTE: The original spec requested Supabase/PostgreSQL. This sandbox environment
// is restricted to SQLite via Prisma, so we adapt: enums become String with app-level
// validation, arrays become Json, and RLS is enforced in the application permission layer
// (lib/permissions.ts) instead of database RLS policies. See README "Assumptions".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization & access control
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  timezone  String   @default("Africa/Lagos")
  currency  String   @default("NGN")
  status        String   @default("active")
  statusReason  String?
  statusChangedAt DateTime?
  planId        String?
  trialEndsAt   DateTime?
  subscriptionEndsAt DateTime?
  gracePeriodEndsAt DateTime?
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  onboardedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches     Branch[]
  users        User[]
  members      Member[]
  settings     Setting[]
  departments  Department[]
  services     Service[]
  visitors     Visitor[]
  followUps    FollowUpTask[]
  events       Event[]
  funds        Fund[]
  donations    Donation[]
  expenses     Expense[]
  budgets      Budget[]
  announcements Announcement[]
  pastoralCases PastoralCase[]
  prayerRequests PrayerRequest[]
  tasks        Task[]
  meetings     Meeting[]
  approvals    Approval[]
  assets       Asset[]
  bookings     Booking[]
  documents    Document[]
  importJobs   ImportJob[]
  roles        Role[]
  userRoleAssignments UserRoleAssignment[]
  accessGrants AccessGrant[]
  approvalPolicies ApprovalPolicy[]
  accessReviews AccessReview[]
  households   Household[]
  relationships Relationship[]
  tithes       Tithe[]
  dependants   Dependant[]
  chatRooms    ChatRoom[]
  chatMessages ChatMessage[]
  plan         Plan?          @relation(fields: [planId], references: [id])
  subscriptions Subscription[]
  invoices     Invoice[]
  invitations  Invitation[]
  tenantAudit  PartnerAudit[]
  statusHistory TenantStatusHistory[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  location       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        Member[]
  services       Service[]
  attendance     AttendanceSession[]
  events         Event[]
  @@index([organizationId])
}

model User {
  id            String   @id @default(cuid())
  organizationId String
  email         String   @unique
  name          String
  passwordHash  String
  role          String   @default("member") // super_admin, church_admin, pastor, finance_officer, department_head, department_assistant, unit_leader, member, guest
  isPartnerAdmin Boolean @default(false)
  phone         String?
  avatarUrl     String?
  active        Boolean  @default(true)
  departmentId  String?  // scope for department_head / assistant
  memberId      String?  @unique
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department    Department? @relation("UserDepartment", fields: [departmentId], references: [id])
  auditLogs     AuditLog[]
  followUpsOwned Member[] @relation("FollowUpOwner")
  headedDepartment Department? @relation("DepartmentHead")
  memberProfile  Member?  @relation("UserMemberProfile", fields: [memberId], references: [id])
  partnerAudit   PartnerAudit[]
  roleAssignments UserRoleAssignment[]
  accessGrants  AccessGrant[]
  reviewedAccess AccessReview[]
  conductedReviews AccessReview[] @relation("AccessReviewReviewer")
  @@index([organizationId])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Membership CRM
// ---------------------------------------------------------------------------

model Member {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  memberId       String?  // human-friendly membership number
  firstName      String
  lastName       String
  middleName     String?
  preferredName  String?
  gender         String?  // male | female | other
  dateOfBirth    DateTime?
  placeOfBirth   String?
  nationality    String?
  stateOfOrigin  String?
  phone          String?
  phoneSecondary String?
  email          String?
  address        String?
  city           String?
  stateProvince  String?
  country        String?
  postalCode     String?
  emergencyName  String?
  emergencyPhone String?
  emergencyRelationship String?
  status         String   @default("visitor") // visitor, new_convert, follow_up, active, inactive, transferred, deceased
  membershipType String   @default("member") // pastor, asst_pastor, deacon, deaconess, member, worker, minister, senior_pastor
  orgUnitType    String?  // branch, parish, province
  isMinor        Boolean  @default(false)
  guardianName   String?
  dateJoined     DateTime @default(now())
  formerChurch   String?
  occupation     String?
  employer       String?
  educationLevel String?  // none, primary, secondary, tertiary, postgraduate
  languages      String?
  maritalStatus  String?  // single, married, divorced, widowed
  weddingAnniversary DateTime?
  householdName  String?
  headOfHousehold Boolean @default(false)
  spouseName     String?
  spouseMemberId String?
  communicationPreference String? @default("sms") // sms, email, phone, whatsapp
  photoConsent   Boolean  @default(false)
  dataConsent    Boolean  @default(false)
  notes          String?
  privateNotes   String?  // restricted
  photoUrl       String?
  householdId    String?
  followUpOwnerId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?   @relation(fields: [branchId], references: [id])
  followUpOwner   User?     @relation("FollowUpOwner", fields: [followUpOwnerId], references: [id])
  account         User?     @relation("UserMemberProfile")
  household       Household? @relation(fields: [householdId], references: [id])
  householdHeadOf Household[] @relation("HouseholdHead")
  relationshipsFrom Relationship[] @relation("RelationshipFrom")
  relationshipsTo   Relationship[] @relation("RelationshipTo")
  tithes         Tithe[]
  dependants     Dependant[]
  departmentMemberships DepartmentMembership[]
  attendance     AttendanceRecord[]
  donations      Donation[]
  pastoralCases  PastoralCase[]
  prayers        PrayerRequest[]
  statusHistory  MemberStatusHistory[]
  @@index([organizationId])
  @@index([status])
  @@index([membershipType])
  @@index([orgUnitType])
}

model MemberStatusHistory {
  id          String   @id @default(cuid())
  memberId    String
  status      String
  reason      String?
  changedAt    DateTime @default(now())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@index([memberId])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  headUserId     String?  @unique
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  head           User?   @relation("DepartmentHead", fields: [headUserId], references: [id])
  members        User[]  @relation("UserDepartment")
  memberships    DepartmentMembership[]
  events         Event[]
  tasks          Task[]
  units          Unit[]
  @@index([organizationId])
}

model DepartmentMembership {
  id           String   @id @default(cuid())
  memberId     String
  departmentId String
  role         String   @default("member") // leader, assistant, secretary, member
  joinedAt     DateTime @default(now())
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  @@unique([memberId, departmentId])
  @@index([departmentId])
}

model Unit {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  leaderUserId String?
  createdAt    DateTime @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Attendance & services
// ---------------------------------------------------------------------------

model Service {
  id          String   @id @default(cuid())
  organizationId String
  branchId    String?
  name        String
  serviceType String   @default("sunday_worship")
  dayOfWeek   Int?     // 0-6
  startTime   String?
  endTime     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?  @relation(fields: [branchId], references: [id])
  sessions    AttendanceSession[]
  @@index([organizationId])
}

model AttendanceSession {
  id          String   @id @default(cuid())
  serviceId   String
  branchId    String?
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch      Branch?  @relation(fields: [branchId], references: [id])
  records     AttendanceRecord[]
  @@index([serviceId])
  @@index([date])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  sessionId   String
  memberId    String?
  visitorName String?
  checkInMethod String @default("manual") // manual | qr
  checkInTime DateTime @default(now())
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, memberId])
  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Visitors & follow-up
// ---------------------------------------------------------------------------

model Visitor {
  id            String   @id @default(cuid())
  organizationId String
  firstName     String
  lastName      String
  phone         String?
  email         String?
  address       String?
  referralSource String?
  firstVisitDate DateTime @default(now())
  convertedMemberId String?
  consent       Boolean  @default(true)
  createdAt     DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  followUps     FollowUpTask[]
  @@index([organizationId])
}

model FollowUpTask {
  id           String   @id @default(cuid())
  visitorId    String?
  memberId     String?
  organizationId String
  ownerId      String?
  status       String   @default("pending") // pending, in_progress, done, lost
  dueDate      DateTime?
  notes        String?
  outcome      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visitor      Visitor? @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  interactions FollowUpInteraction[]
  @@index([organizationId])
  @@index([status])
}

model FollowUpInteraction {
  id        String   @id @default(cuid())
  taskId    String
  method    String   @default("call") // call, sms, email, visit
  notes     String?
  createdAt DateTime @default(now())
  task      FollowUpTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Events & calendar
// ---------------------------------------------------------------------------

model Event {
  id            String   @id @default(cuid())
  organizationId String
  branchId      String?
  departmentId  String?
  title         String
  description   String?
  eventType     String   @default("service") // service, conference, meeting, retreat, outreach, training, special
  venue         String?
  capacity      Int?
  startDate     DateTime
  endDate       DateTime?
  status        String   @default("scheduled") // scheduled, approved, cancelled, completed
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?  @relation(fields: [branchId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])
  registrations Registration[]
  @@index([organizationId])
  @@index([startDate])
}

model Registration {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@unique([eventId, email])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Finance & giving
// ---------------------------------------------------------------------------

model Fund {
  id            String   @id @default(cuid())
  organizationId String
  name          String
  code          String?
  description   String?
  balance       Float    @default(0)
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  donations     Donation[]
  expenses      Expense[]
  budgets       Budget[]
  @@index([organizationId])
}

model Donation {
  id            String   @id @default(cuid())
  organizationId String
  fundId        String?
  memberId      String?
  donorName     String?
  amount        Float
  currency      String   @default("NGN")
  method        String   @default("cash") // cash, transfer, card, online
  reference     String?
  status        String   @default("confirmed") // pending, confirmed, failed, refunded
  donatedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  fund          Fund?    @relation(fields: [fundId], references: [id])
  member        Member?  @relation(fields: [memberId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([donatedAt])
}

model Expense {
  id            String   @id @default(cuid())
  organizationId String
  fundId        String?
  category      String
  description   String
  amount        Float
  payee         String?
  method        String   @default("cash")
  reference     String?
  status        String   @default("pending") // pending, approved, paid, rejected
  approvedBy    String?
  incurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  fund          Fund?    @relation(fields: [fundId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([status])
}

model Budget {
  id            String   @id @default(cuid())
  organizationId String
  fundId        String?
  fiscalYear    Int
  period        String   @default("annual")
  amount        Float
  createdAt     DateTime @default(now())
  fund          Fund?    @relation(fields: [fundId], references: [id])
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Communications
// ---------------------------------------------------------------------------

model Announcement {
  id            String   @id @default(cuid())
  organizationId String
  title         String
  body          String
  audience      String   @default("all") // all, members, department, leaders
  departmentId  String?
  published     Boolean  @default(true)
  pinned        Boolean  @default(false)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Pastoral care & welfare
// ---------------------------------------------------------------------------

model PastoralCase {
  id            String   @id @default(cuid())
  organizationId String
  memberId      String?
  type          String   @default("prayer") // prayer, counselling, visitation, bereavement, hospital, welfare
  status        String   @default("open") // open, in_progress, resolved, closed
  priority      String   @default("normal") // low, normal, high, urgent
  assignedToId  String?
  description   String?
  privateNotes  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  member        Member?  @relation(fields: [memberId], references: [id])
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([status])
}

model PrayerRequest {
  id           String   @id @default(cuid())
  organizationId String
  memberId     String?
  name         String?
  request      String
  private      Boolean  @default(false)
  status       String   @default("open")
  createdAt    DateTime @default(now())
  member       Member?  @relation(fields: [memberId], references: [id])
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Tasks, meetings, approvals
// ---------------------------------------------------------------------------

model Task {
  id           String   @id @default(cuid())
  organizationId String
  departmentId String?
  title        String
  description  String?
  assigneeId   String?
  status       String   @default("todo") // todo, in_progress, review, done, blocked, cancelled
  priority     String   @default("normal")
  labels       String?
  estimatedHours Float?
  loggedHours  Float    @default(0)
  parentTaskId String?
  dueDate      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Task?    @relation("TaskSubtask", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks     Task[]   @relation("TaskSubtask")
  comments     TaskComment[]
  @@index([organizationId])
  @@index([status])
}

model Meeting {
  id            String   @id @default(cuid())
  organizationId String
  title         String
  agenda        String?
  minutes       String?
  location      String?
  attendees     String?
  scheduledAt   DateTime
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

model Approval {
  id            String   @id @default(cuid())
  organizationId String
  type          String   // expense, event, member_status, document
  refId         String
  requesterId   String?
  approverId    String?
  status        String   @default("pending") // pending, approved, rejected
  comment       String?
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Assets & facilities
// ---------------------------------------------------------------------------

model Asset {
  id            String   @id @default(cuid())
  organizationId String
  tag           String?
  name          String
  category      String   // equipment, instrument, furniture, vehicle, building, it
  location      String?
  custodian     String?
  condition     String   @default("good") // good, fair, damaged, retired
  acquiredAt    DateTime?
  value         Float?
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([category])
}

model Booking {
  id            String   @id @default(cuid())
  organizationId String
  resource      String
  title         String
  bookedBy      String?
  startAt       DateTime
  endAt         DateTime
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Document {
  id            String   @id @default(cuid())
  organizationId String
  title         String
  category      String   @default("policy") // policy, template, minutes, form, report, resource
  description   String?
  fileUrl       String?
  fileName      String?
  accessLevel   String   @default("staff") // public, members, staff, leaders, finance, pastoral
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([accessLevel])
}

// ---------------------------------------------------------------------------
// Audit log & settings
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(cuid())
  organizationId String?
  actorId       String?
  action        String
  targetType    String?
  targetId      String?
  metadata      String?
  ip            String?
  createdAt     DateTime @default(now())
  actor         User?    @relation(fields: [actorId], references: [id])
  @@index([organizationId])
  @@index([actorId])
  @@index([action])
}

model Setting {
  id            String   @id @default(cuid())
  organizationId String
  key           String
  value         String
  updatedAt     DateTime @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, key])
}

model ImportJob {
  id            String   @id @default(cuid())
  organizationId String
  kind          String
  fileName      String
  totalRows     Int      @default(0)
  successRows   Int      @default(0)
  errorRows     Int      @default(0)
  status        String   @default("pending")
  errors        String?
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Households, family relationships, dependants, tithes (Task 12)
// ---------------------------------------------------------------------------

model Household {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  headMemberId   String?
  address        String?
  phone          String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  head           Member?  @relation("HouseholdHead", fields: [headMemberId], references: [id], onDelete: SetNull)
  members        Member[]
  @@index([organizationId])
}

model Relationship {
  id             String   @id @default(cuid())
  organizationId String
  fromMemberId   String
  toMemberId     String
  relationType   String   // spouse, child, parent, sibling, guardian, dependent, other
  note           String?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromMember     Member   @relation("RelationshipFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember       Member   @relation("RelationshipTo", fields: [toMemberId], references: [id], onDelete: Cascade)
  @@unique([fromMemberId, toMemberId, relationType])
  @@index([organizationId])
  @@index([fromMemberId])
  @@index([toMemberId])
}

model Dependant {
  id             String   @id @default(cuid())
  organizationId String
  memberId       String
  name           String
  relationship   String   // son, daughter, dependent, ward
  dateOfBirth    DateTime?
  gender         String?
  note           String?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([memberId])
}

model Tithe {
  id             String   @id @default(cuid())
  organizationId String
  memberId       String
  amount         Float
  currency       String   @default("NGN")
  method         String   @default("cash")
  reference       String?
  status         String   @default("confirmed")
  titheMonth     DateTime
  note           String?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([memberId])
  @@index([titheMonth])
}

model TaskComment {
  id           String   @id @default(cuid())
  taskId       String
  authorId     String?
  authorName   String
  body         String
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Roles & permissions (editable Access Control)
// ---------------------------------------------------------------------------

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  label          String
  description    String?
  color          String?
  isSystem       Boolean  @default(false)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  fieldPermissions FieldPermission[]
  assignments    UserRoleAssignment[]
  @@unique([organizationId, name])
  @@index([organizationId])
}

model RolePermission {
  id        String   @id @default(cuid())
  roleId    String
  module    String
  action    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([roleId, module, action])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Partner Portal — multi-tenant SaaS management
// ---------------------------------------------------------------------------

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  price       Float    @default(0)
  currency    String   @default("NGN")
  billingInterval String @default("monthly")
  trialDays   Int      @default(0)
  maxUsers        Int  @default(10)
  maxMembers      Int  @default(500)
  maxAdmins       Int  @default(3)
  maxBranches     Int  @default(1)
  storageMb       Int  @default(500)
  modules     String   @default("dashboard,members,departments,attendance,events,finance,announcements,pastoral,tasks,assets,documents,reports,celebrations,townhall")
  features    String?
  supportLevel String  @default("email")
  apiAccess    Boolean  @default(false)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  organizations Organization[]
  subscriptions Subscription[]
}

model Subscription {
  id            String   @id @default(cuid())
  organizationId String
  planId        String
  status        String   @default("active")
  billingInterval String @default("monthly")
  startDate     DateTime @default(now())
  renewalDate   DateTime?
  expiryDate    DateTime?
  gracePeriodEndsAt DateTime?
  amount        Float
  currency      String   @default("NGN")
  paymentStatus String   @default("pending")
  autoRenew     Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan          Plan     @relation(fields: [planId], references: [id])
  invoices      Invoice[]
  @@index([organizationId])
  @@index([status])
}

model Invoice {
  id            String   @id @default(cuid())
  organizationId String
  subscriptionId String?
  number        String   @unique
  amount        Float
  currency      String   @default("NGN")
  status        String   @default("pending")
  issueDate     DateTime @default(now())
  dueDate       DateTime?
  paidDate      DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id])
  payments      Payment[]
  @@index([organizationId])
  @@index([status])
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String
  amount        Float
  currency      String   @default("NGN")
  method        String   @default("manual")
  reference     String?
  status        String   @default("pending")
  verified      Boolean  @default(false)
  verifiedAt    DateTime?
  provider      String?
  metadata      String?
  createdAt     DateTime @default(now())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@index([invoiceId])
  @@index([status])
}

model Invitation {
  id            String   @id @default(cuid())
  organizationId String
  email         String
  role          String   @default("church_admin")
  token         String   @unique
  status        String   @default("pending")
  expiresAt     DateTime
  acceptedAt    DateTime?
  invitedBy     String?
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([status])
}

model PartnerAudit {
  id            String   @id @default(cuid())
  organizationId String?
  actorId       String?
  action        String
  targetType    String?
  targetId      String?
  outcome       String   @default("success")
  reason        String?
  metadata      String?
  ip            String?
  createdAt     DateTime @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([organizationId])
  @@index([actorId])
  @@index([action])
}

model TenantStatusHistory {
  id            String   @id @default(cuid())
  organizationId String
  fromStatus    String?
  toStatus      String
  reason        String?
  changedById   String?
  changedAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Townhall chat (with threads + themes)
// ---------------------------------------------------------------------------

model ChatRoom {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  type           String   @default("townhall") // townhall | department | role | group | direct
  refId          String?  // departmentId / role name / sorted user ids for direct
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]
  @@index([organizationId])
  @@index([type])
}

model ChatMessage {
  id             String   @id @default(cuid())
  organizationId String
  roomId         String
  senderId       String
  senderName     String
  body           String
  parentId       String?  // for threaded replies
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  room           ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  replies        ChatMessage[] @relation("MessageReply")
  parent         ChatMessage? @relation("MessageReply", fields: [parentId], references: [id], onDelete: SetNull)
  @@index([roomId])
  @@index([organizationId])
  @@index([senderId])
  @@index([parentId])
}

// ===========================================================================
// ENTERPRISE ACCESS CONTROL — ABAC, field-level, approval workflows
// ===========================================================================

// User-role assignments (multi-role support + scope + temporary grants)
model UserRoleAssignment {
  id            String   @id @default(cuid())
  organizationId String
  userId        String
  roleId        String
  scopeType     String   @default("org") // org, branch, department, group, record
  scopeId       String?  // branchId / departmentId / groupId / recordId
  grantedById   String?
  expiresAt     DateTime? // null = permanent
  active        Boolean  @default(true)
  reason        String?
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([userId, roleId, scopeType, scopeId])
  @@index([organizationId])
  @@index([userId])
  @@index([roleId])
}

// Field-level permissions per role (which sensitive fields are visible/editable)
model FieldPermission {
  id        String   @id @default(cuid())
  roleId    String
  module    String   // members, finance, pastoral, etc.
  field     String   // phone, email, address, donationHistory, privateNotes, etc.
  access    String   @default("none") // none, masked, view, edit
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([roleId, module, field])
  @@index([roleId])
}

// Access grants — temporary or permanent explicit record-level access
model AccessGrant {
  id            String   @id @default(cuid())
  organizationId String
  userId        String
  resourceType  String   // member, case, fund, document, etc.
  resourceId    String
  permission    String   @default("view") // view, edit, manage
  grantedById   String?
  expiresAt     DateTime?
  reason        String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([userId])
  @@index([resourceType, resourceId])
}

// Approval policies for sensitive operations
model ApprovalPolicy {
  id            String   @id @default(cuid())
  organizationId String
  name          String
  action        String   // finance.expense.approve, access.role.change, export.sensitive, etc.
  description   String?
  requiresApproval Boolean @default(true)
  approverRoleId String?  // role that can approve
  selfApprovalBlocked Boolean @default(true) // cannot approve own action
  minApprovers  Int      @default(1)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([action])
}

// Access review records (periodic review of user access)
model AccessReview {
  id            String   @id @default(cuid())
  organizationId String
  reviewerId    String?
  userId        String
  roleId        String?
  reviewDate    DateTime @default(now())
  decision      String   // approved, revoked, modified
  notes         String?
  nextReviewDate DateTime?
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewer      User?    @relation("AccessReviewReviewer", fields: [reviewerId], references: [id])
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@index([userId])
}
